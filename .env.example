# Telegram
BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
BOT_OWNER_IDS=

# Supabase (service role key must remain private)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Quotas
FREE_DAILY_LIMIT=5
PREMIUM_DAILY_LIMIT=100
MAX_BATCH_SIZE=50

# API fallback
API_FALLBACK_ENABLED=true
ALLOW_PAID_LOOKUPS=false

# Abstract Phone Validation API
ENABLE_ABSTRACT=false
ABSTRACT_API_KEY=

# Numverify (check commercial-use terms before enabling)
ENABLE_NUMVERIFY=false
NUMVERIFY_API_KEY=

# Twilio Lookup Basic
ENABLE_TWILIO=false
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=

# Public Vercel URL used to load the menu banner image
APP_PUBLIC_URL=https://your-project.vercel.app
